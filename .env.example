# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transcription provider: auto | speech | openai | foundry | demo
# auto prefers Azure Speech MAI-Transcribe, then public OpenAI Whisper, then optional Foundry STT, else demo.
TRANSCRIPTION_PROVIDER=auto

# --- Azure Speech (primary STT — AgileBoard MAI-Transcribe) ---
# Regional Speech endpoint, e.g. https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_API_KEY=
# Model id (AgileBoard export uses mai-transcribe-1.5; normalized to MAI-Transcribe-1.5)
AZURE_SPEECH_TRANSCRIPTION_MODEL=mai-transcribe-1.5
# Optional aliases:
# SPEECH_ENDPOINT=
# SPEECH_API_KEY=
# SPEECH_TRANSCRIPTION_MODEL=
# AZURE_SPEECH_API_VERSION=2025-10-15

# --- Microsoft Foundry / Azure OpenAI (optional cleanup + demoted STT fallback) ---
# Resource root, e.g. https://your-resource.openai.azure.com
AZURE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=2024-06-01
# Optional transcript cleanup via chat deployment (off by default)
# AZURE_FOUNDRY_TRANSCRIPT_CLEANUP=false
AZURE_FOUNDRY_CLEANUP_DEPLOYMENT=DeepSeek-V4-Pro
# Demoted OpenAI-compatible STT only if Speech is unavailable:
# AZURE_FOUNDRY_TRANSCRIPTION_DEPLOYMENT=gpt-4o-mini-transcribe
# Aliases: AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY, AZURE_OPENAI_* 

# --- Legacy public OpenAI Whisper (optional fallback) ---
# OPENAI_API_KEY=
