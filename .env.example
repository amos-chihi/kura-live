# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transcription provider: auto | foundry | openai | demo
# auto prefers Microsoft Foundry when endpoint+key are set, else OpenAI Whisper, else demo scripts.
TRANSCRIPTION_PROVIDER=auto

# --- Microsoft Foundry / Azure OpenAI (preferred) ---
# Use the OpenAPI v1 base, e.g. https://<resource>.openai.azure.com/openai/v1
AZURE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=

# Speech-to-text deployment name on the Foundry resource (must be deployed).
# Recommended (best → good for live 8s chunks): gpt-4o-mini-transcribe | gpt-4o-transcribe | whisper
AZURE_FOUNDRY_TRANSCRIPTION_DEPLOYMENT=gpt-4o-mini-transcribe

# Optional aliases (same meaning as AZURE_FOUNDRY_*):
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=

# Optional post-STT cleanup via a chat deployment (off by default).
# Prefer Llama-3.3-70B-Instruct or DeepSeek-V4-Pro — not embeddings/document AI.
# AZURE_FOUNDRY_TRANSCRIPT_CLEANUP=false
# AZURE_FOUNDRY_CLEANUP_DEPLOYMENT=Llama-3.3-70B-Instruct

# --- Legacy public OpenAI Whisper (fallback) ---
# OPENAI_API_KEY=
